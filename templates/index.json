          "settings": {
            "question": "Can an RTX 3050 or RTX 3060 run GTA 6?",
            "answer": "On our estimate, both clear the lowest level, 1080p at low settings, if the processor and memory keep up. Both fall short of our estimate for 1080p at high settings, which is around an RTX 3060 Ti or RX 6700 XT."
          }
        },
        "faq_4": {
