{% comment %}
  PC checker: lets a visitor pick their PC parts and see an estimate of whether the game would run.
  The parts lists and the estimated requirements live in assets/pc-checker.js.
{% endcomment %}

<script
  src="{{ 'pc-checker.js' | asset_url }}"
  type="module"
></script>

{% if section.settings.landing_mode %}
  {% style %}
    .shopify-section-group-header-group,
    .shopify-section-group-footer-group {
      display: none;
    }

    body {
      background: #0c0f16;
    }
  {% endstyle %}
{% endif %}

{% liquid
  assign card = blank
  assign card_gpu = blank
  if request.page_type == 'page' and section.settings.use_page_content
    assign card = page.metafields.custom.card.value
    if card != blank
      assign card_gpu = card.n
    endif
  endif

  comment
    Level names and example parts for the single-card text. Keep in step with TIERS in assets/pc-checker.js.
  endcomment
  assign level_names = '1080p, low settings|1080p, high settings|1440p, high settings|4K, high settings' | split: '|'
  assign level_cards = 'GTX 1660 Super or RX 5600 XT|RTX 3060 Ti or RX 6700 XT|RTX 4070 Super or RX 7800 XT|RTX 4080 or RX 9070 XT' | split: '|'
  assign level_memory = '6|8|12|16' | split: '|'
%}

<div
  class="pc-checker-shell"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div
    class="pc-checker"
    data-pc-checker
    {% if card_gpu != blank %}
      data-preselect-gpu="{{ card_gpu | escape }}"
    {% endif %}
  >
    <script
      type="application/json"
      data-pc-checker-config
    >
      {
        "links": {
          "gpu": {{ section.settings.gpu_link | json }},
          "cpu": {{ section.settings.cpu_link | json }},
          "ram": {{ section.settings.ram_link | json }},
          "ssd": {{ section.settings.ssd_link | json }},
          "pc": {{ section.settings.pc_link | json }}
        },
        "affiliateNote": {{ section.settings.affiliate_note | json }}
      }
    </script>

    {% if section.settings.landing_mode %}
      <p class="pc-checker__brand">{{ shop.name | escape }}</p>
    {% endif %}

    <header class="pc-checker__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="pc-checker__chip">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if request.page_type == 'page' and section.settings.use_page_content %}
        <h1 class="pc-checker__title pc-checker__title--page">{{ page.title | escape }}</h1>
        {% if card != blank %}
          {% liquid
            assign levels = card.l | split: ''
            assign reasons = card.r | split: ''
          %}
          <div class="pc-checker__article">
            <p>
              <strong>
                {%- if card.b >= 0 -%}
                  Our estimate: the {{ card.n | escape }} should run GTA 6 on PC at {{ level_names[card.b] }}, as long
                  as the processor, memory and drive keep up.
                {%- elsif levels[0] == 'n' -%}
                  Our estimate: the {{ card.n | escape }} is borderline for GTA 6 on PC, even at 1080p with low
                  settings.
                {%- else -%}
                  Our estimate: the {{ card.n | escape }} is unlikely to run GTA 6 on PC.
                {%- endif -%}
              </strong>
            </p>
            <p>
              Rockstar has not announced a PC version of Grand Theft Auto VI or its requirements, so this is our own
              estimate and not an official figure.
            </p>

            <h2>{{ card.n | escape }} at each quality level</h2>
            <ul>
              {% for level_name in level_names %}
                {% liquid
                  assign state = levels[forloop.index0]
                  assign why = reasons[forloop.index0]
                %}
                <li>
                  {{ level_name }}:
                  {% if state == 'p' %}
                    Should run
                  {% elsif state == 'n' %}
                    Borderline
                  {% else %}
                    Unlikely
                  {% endif %}
                  {% if why == 's' %}
                    (not fast enough on our estimate)
                  {% elsif why == 'v' %}
                    ({{ card.v }} GB of video memory against an estimated {{ level_memory[forloop.index0] }} GB)
                  {% elsif why == 'b' %}
                    (not fast enough on our estimate; {{ card.v }} GB of video memory against an estimated
                    {{ level_memory[forloop.index0] }} GB)
                  {% endif %}
                </li>
              {% endfor %}
            </ul>

            <h2>What would it take to go higher?</h2>
            {% if card.x >= 0 %}
              <p>
                The {{ card.n | escape }} has {{ card.v }} GB of video memory. Our estimate for
                {{ level_names[card.x] }} is a card around {{ level_cards[card.x] }} with {{ level_memory[card.x] }} GB.
              </p>
            {% else %}
              <p>
                The {{ card.n | escape }} has {{ card.v }} GB of video memory and clears every level in our estimate,
                including 4K at high settings.
              </p>
            {% endif %}
            {% if card.d != blank or card.u != blank %}
              <p>
                For comparison:
                {% if card.d != blank %}
                  {% assign down_handle = card.d | handleize %}
                  <a href="{{ routes.root_url }}pages/can-the-{{ down_handle }}-run-gta-6">{{ card.d | escape }}</a>
                  is the next card down in our list.
                {% endif %}
                {% if card.u != blank %}
                  {% assign up_handle = card.u | handleize %}
                  <a href="{{ routes.root_url }}pages/can-the-{{ up_handle }}-run-gta-6">{{ card.u | escape }}</a>
                  is the next card up.
                {% endif %}
              </p>
            {% endif %}

            <h2>Laptop version</h2>
            <p>
              Laptop versions of a graphics card are roughly a fifth slower than the desktop card with the same name.
              If yours is in a laptop, our estimate
              {% if card.t >= 0 %}
                is {{ level_names[card.t] }}.
              {% else %}
                falls below the lowest level.
              {% endif %}
            </p>
            <p>
              The graphics card is only one part. Add your processor, memory and drive in the checker below for the
              full result.
            </p>
          </div>
        {% elsif page.content != blank %}
          <div class="pc-checker__article">{{ page.content }}</div>
        {% endif %}
        <p class="pc-checker__back">
          <a href="{{ routes.root_url }}">Check a different PC</a>
        </p>
      {% else %}
        <h1 class="pc-checker__title">
          {{ section.settings.heading | escape }}
          {% if section.settings.heading_highlight != blank %}
            <span class="pc-checker__title-highlight">{{ section.settings.heading_highlight | escape }}</span>
          {% endif %}
        </h1>
        {% if section.settings.intro != blank %}
          <p class="pc-checker__lede">{{ section.settings.intro | escape }}</p>
        {% endif %}
      {% endif %}
      <ul
        class="pc-checker__stats"
        data-pc-checker-stats
      ></ul>
      {% if section.settings.notice != blank %}
        <p class="pc-checker__notice">{{ section.settings.notice | escape }}</p>
      {% endif %}
    </header>

    <div class="pc-checker__grid">
      <form
        class="pc-checker__card pc-checker__form"
        data-pc-checker-form
      >
        <h2 class="pc-checker__subtitle">Your PC</h2>

        <label
          class="pc-checker__label"
          for="PcCheckerGpu-{{ section.id }}"
        >
          Graphics card
        </label>
        <select
          class="pc-checker__select"
          id="PcCheckerGpu-{{ section.id }}"
          name="gpu"
        ></select>

        <label class="pc-checker__check">
          <input
            type="checkbox"
            name="laptop"
          >
          <span>It is a laptop</span>
        </label>

        <label
          class="pc-checker__label"
          for="PcCheckerCpu-{{ section.id }}"
        >
          Processor
        </label>
        <select
          class="pc-checker__select"
          id="PcCheckerCpu-{{ section.id }}"
          name="cpu"
        ></select>

        <label
          class="pc-checker__label"
          for="PcCheckerRam-{{ section.id }}"
        >
          Memory (RAM)
        </label>
        <select
          class="pc-checker__select"
          id="PcCheckerRam-{{ section.id }}"
          name="ram"
        >
          <option value="8">8 GB</option>
          <option value="12">12 GB</option>
          <option
            value="16"
            selected
          >
            16 GB
          </option>
          <option value="24">24 GB</option>
          <option value="32">32 GB</option>
          <option value="64">64 GB or more</option>
        </select>

        <label
          class="pc-checker__label"
          for="PcCheckerStorage-{{ section.id }}"
        >
          Drive the game would be installed on
        </label>
        <select
          class="pc-checker__select"
          id="PcCheckerStorage-{{ section.id }}"
          name="storage"
        >
          <option value="ssd">SSD</option>
          <option value="hdd">Hard drive (HDD)</option>
        </select>

        <p class="pc-checker__hint">
          Not sure what you have? On Windows, press Ctrl + Shift + Esc and open the Performance tab.
        </p>
      </form>

      <div
        class="pc-checker__card pc-checker__result"
        id="PcCheckerResult-{{ section.id }}"
      >
        <div
          class="pc-checker__output"
          data-pc-checker-output
          aria-live="polite"
        >
          <noscript>This checker needs JavaScript. The estimated requirements are listed below.</noscript>
        </div>

        {% if section.settings.gate_result %}
          <div
            class="pc-checker__gate"
            data-pc-checker-gate
            hidden
          >
            <span
              class="pc-checker__lock"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect
                  x="4"
                  y="11"
                  width="16"
                  height="10"
                  rx="2"
                />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
            </span>
            {% if section.settings.gate_heading != blank %}
              <h2 class="pc-checker__gate-title">{{ section.settings.gate_heading | escape }}</h2>
            {% endif %}
            {% if section.settings.gate_text != blank %}
              <p class="pc-checker__gate-text">{{ section.settings.gate_text | escape }}</p>
            {% endif %}
            {% assign gate_form_id = 'PcCheckerGate-' | append: section.id %}
            {%- form 'customer', id: gate_form_id, class: 'pc-checker__email-form pc-checker__gate-form' -%}
              <input
                type="hidden"
                name="contact[tags]"
                value="newsletter,pc-version-alert"
              >
              <label
                class="visually-hidden"
                for="PcCheckerGateEmail-{{ section.id }}"
              >
                Email address
              </label>
              <input
                class="pc-checker__email"
                id="PcCheckerGateEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                placeholder="you@example.com"
                required
              >
              <button
                class="pc-checker__button"
                type="submit"
              >
                {{ section.settings.gate_button | escape }}
              </button>
              {% if form.posted_successfully? %}
                <span
                  data-pc-checker-posted
                  hidden
                ></span>
              {% elsif form.errors %}
                <p
                  class="pc-checker__form-message pc-checker__form-message--error"
                  role="alert"
                >
                  That email address did not work. Check it and try again.
                </p>
              {% endif %}
            {%- endform -%}
            {% if shop.privacy_policy %}
              <p class="pc-checker__gate-legal">
                See our <a href="{{ shop.privacy_policy.url }}">privacy policy</a>.
              </p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_signup and section.settings.gate_result == false %}
      <section class="pc-checker__card pc-checker__signup">
        {% if section.settings.signup_heading != blank %}
          <h2 class="pc-checker__subtitle">{{ section.settings.signup_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.signup_text != blank %}
          <p class="pc-checker__signup-text">{{ section.settings.signup_text | escape }}</p>
        {% endif %}
        {% assign signup_form_id = 'PcCheckerSignup-' | append: section.id %}
        {%- form 'customer', id: signup_form_id, class: 'pc-checker__email-form' -%}
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter,pc-version-alert"
          >
          <label
            class="visually-hidden"
            for="PcCheckerEmail-{{ section.id }}"
          >
            Email address
          </label>
          <input
            class="pc-checker__email"
            id="PcCheckerEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            placeholder="you@example.com"
            required
          >
          <button
            class="pc-checker__button"
            type="submit"
          >
            {{ section.settings.signup_button | escape }}
          </button>
          {% if form.posted_successfully? %}
            <p
              class="pc-checker__form-message"
              role="status"
            >
              You are on the list. We will email you when there is news.
            </p>
          {% elsif form.errors %}
            <p
              class="pc-checker__form-message pc-checker__form-message--error"
              role="alert"
            >
              That email address did not work. Check it and try again.
            </p>
          {% endif %}
        {%- endform -%}
      </section>
    {% endif %}

    <section class="pc-checker__method">
      <h2 class="pc-checker__subtitle">Estimated requirements</h2>
      <div class="pc-checker__table-wrap">
        <table class="pc-checker__table">
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Graphics card</th>
              <th scope="col">Processor</th>
              <th scope="col">Memory</th>
            </tr>
          </thead>
          <tbody data-pc-checker-estimates></tbody>
        </table>
      </div>
      {% if section.settings.method != blank %}
        <p class="pc-checker__method-note">{{ section.settings.method | escape }}</p>
      {% endif %}
      {% if section.settings.updated != blank %}
        <p class="pc-checker__method-note">{{ section.settings.updated | escape }}</p>
      {% endif %}
    </section>

    {% if section.blocks.size > 0 %}
      <section class="pc-checker__faq">
        {% if section.settings.faq_heading != blank %}
          <h2 class="pc-checker__subtitle">{{ section.settings.faq_heading | escape }}</h2>
        {% endif %}
        <div class="pc-checker__faq-list">
          {% for block in section.blocks %}
            <details
              class="pc-checker__faq-item"
              {{ block.shopify_attributes }}
            >
              <summary class="pc-checker__faq-question">{{ block.settings.question | escape }}</summary>
              <p class="pc-checker__faq-answer">{{ block.settings.answer | escape }}</p>
            </details>
          {% endfor %}
        </div>
      </section>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | json }}
                }
              }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {% endif %}

    {% assign cards_menu = section.settings.cards_menu %}
    {% if cards_menu != blank and cards_menu.links.size > 0 %}
      <nav
        class="pc-checker__cards"
        aria-label="{{ section.settings.cards_heading | escape }}"
      >
        {% if section.settings.cards_heading != blank %}
          <h2 class="pc-checker__subtitle">{{ section.settings.cards_heading | escape }}</h2>
        {% endif %}
        <ul class="pc-checker__cards-list">
          {% for link in cards_menu.links %}
            <li>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="pc-checker__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {% endif %}

    {% if section.settings.landing_mode %}
      <p class="pc-checker__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
        {% if shop.privacy_policy %}
          <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>
        {% endif %}
      </p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* One deliberate dark look: graphite surfaces, warm amber-to-coral accent, soft glow behind the hero. */
  .pc-checker-shell {
    --pc-bg: #0c0f16;
    --pc-surface: #141925;
    --pc-surface-2: #1b2231;
    --pc-line: rgb(255 255 255 / 0.1);
    --pc-text: #f4f1ea;
    --pc-muted: #a4abbb;
    --pc-accent: #ffb454;
    --pc-accent-2: #ff6f61;
    --pc-pass: #3ecf8e;
    --pc-near: #f5b83d;
    --pc-fail: #ff6b6b;
    --pc-radius: 1.125rem;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100dvh;
    padding-inline: max(1rem, env(safe-area-inset-left, 0px)) max(1rem, env(safe-area-inset-right, 0px));
    background: var(--pc-bg);
    color: var(--pc-text);
    color-scheme: dark;
    line-height: 1.5;
  }

  .pc-checker-shell::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 46rem;
    z-index: -1;
    background:
      radial-gradient(40rem 24rem at 12% -6%, rgb(255 111 97 / 0.22), transparent 70%),
      radial-gradient(36rem 22rem at 92% 4%, rgb(255 180 84 / 0.16), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 100% 3rem,
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 3rem 100%;
    mask-image: linear-gradient(#000 55%, transparent);
    pointer-events: none;
  }

  .pc-checker {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    max-width: 68rem;
    margin-inline: auto;
    width: 100%;
  }

  .pc-checker :where(h1, h2, h3, p, ul) {
    margin: 0;
  }

  .pc-checker :where(a) {
    color: inherit;
  }

  .pc-checker__brand {
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pc-checker__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
    max-width: 46rem;
  }

  .pc-checker__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--pc-line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: var(--pc-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pc-checker__chip::before {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--pc-accent);
    box-shadow: 0 0 0.625rem var(--pc-accent);
  }

  .pc-checker__title {
    font-family: var(--font-heading--family);
    font-size: clamp(2.375rem, 8.5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--pc-text);
  }

  .pc-checker__title-highlight {
    display: block;
    background: linear-gradient(95deg, var(--pc-accent), var(--pc-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pc-checker__lede {
    max-width: 36rem;
    color: var(--pc-muted);
    font-size: 1.125rem;
  }

  .pc-checker__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
  }

  .pc-checker__stats li {
    display: flex;
    align-items: baseline;
    gap: 0.4375rem;
    color: var(--pc-muted);
    font-size: 0.9375rem;
  }

  .pc-checker__stats strong {
    color: var(--pc-text);
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .pc-checker__notice {
    padding: 0.75rem 1rem;
    border-inline-start: 2px solid var(--pc-accent);
    background: rgb(255 180 84 / 0.07);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--pc-text);
    font-size: 0.9375rem;
  }

  .pc-checker__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media screen and (min-width: 750px) {
    .pc-checker__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 1.5rem;
      align-items: start;
    }
  }

  .pc-checker__card {
    min-width: 0;
    padding: 1.375rem;
    border: 1px solid var(--pc-line);
    border-radius: var(--pc-radius);
    background: linear-gradient(180deg, var(--pc-surface-2), var(--pc-surface));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.7);
  }

  @media screen and (min-width: 750px) {
    .pc-checker__card {
      padding: 1.75rem;
    }
  }

  .pc-checker__form,
  .pc-checker__output,
  .pc-checker__method,
  .pc-checker__signup {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .pc-checker__subtitle {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--pc-text);
  }

  .pc-checker__label {
    margin-top: 0.375rem;
    color: var(--pc-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pc-checker__select,
  .pc-checker__email {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--pc-line);
    border-radius: 0.75rem;
    background-color: rgb(0 0 0 / 0.28);
    color: var(--pc-text);
    font: inherit;
    font-size: 1rem;
  }

  .pc-checker__select:hover,
  .pc-checker__email:hover {
    border-color: rgb(255 255 255 / 0.22);
  }

  .pc-checker__select:focus-visible,
  .pc-checker__email:focus-visible,
  .pc-checker__button:focus-visible,
  .pc-checker__check input:focus-visible,
  .pc-checker :where(a):focus-visible {
    outline: 2px solid var(--pc-accent);
    outline-offset: 2px;
  }

  .pc-checker__email::placeholder {
    color: rgb(164 171 187 / 0.7);
  }

  .pc-checker__check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .pc-checker__check input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--pc-accent);
  }

  .pc-checker__hint,
  .pc-checker__method-note,
  .pc-checker__disclaimer,
  .pc-checker__example,
  .pc-checker__advice-note,
  .pc-checker__scale-note,
  .pc-checker__tier-note,
  .pc-checker__signup-text,
  .pc-checker__gate-legal {
    color: var(--pc-muted);
    font-size: 0.875rem;
  }

  .pc-checker__result {
    position: relative;
    overflow: hidden;
  }

  .pc-checker__output {
    gap: 1.375rem;
  }

  .pc-checker__output-body,
  .pc-checker__placeholder {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  .pc-checker__output.is-locked {
    filter: blur(7px);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
    min-height: 26rem;
  }

  .pc-checker__gate {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1.5rem;
    text-align: center;
    background: radial-gradient(closest-side, rgb(12 15 22 / 0.86), rgb(12 15 22 / 0.5));
  }

  .pc-checker__lock {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pc-accent), var(--pc-accent-2));
    color: #1a1206;
    box-shadow: 0 0 2.5rem rgb(255 140 90 / 0.45);
  }

  .pc-checker__gate-title {
    font-family: var(--font-heading--family);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--pc-text);
  }

  .pc-checker__gate-text {
    max-width: 26rem;
    color: var(--pc-text);
    font-size: 0.9375rem;
  }

  .pc-checker__email-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
    max-width: 28rem;
  }

  .pc-checker__email-form .pc-checker__email {
    flex: 1 1 13rem;
    width: auto;
    background-color: rgb(0 0 0 / 0.45);
  }

  .pc-checker__button {
    flex: 1 0 auto;
    min-height: 3rem;
    padding: 0 1.375rem;
    border: 0;
    border-radius: 0.75rem;
    background: linear-gradient(95deg, var(--pc-accent), var(--pc-accent-2));
    color: #1a1206;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .pc-checker__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 0.625rem 1.5rem -0.5rem rgb(255 140 90 / 0.7);
  }

  .pc-checker__form-message {
    flex-basis: 100%;
    font-size: 0.9375rem;
  }

  .pc-checker__form-message--error {
    color: var(--pc-fail);
  }

  .pc-checker__headline {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pc-checker__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--pc-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pc-checker__eyebrow::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--pc-muted);
  }

  .pc-checker__headline--pass .pc-checker__eyebrow::before {
    background: var(--pc-pass);
    box-shadow: 0 0 0.75rem var(--pc-pass);
  }

  .pc-checker__headline--near .pc-checker__eyebrow::before {
    background: var(--pc-near);
    box-shadow: 0 0 0.75rem var(--pc-near);
  }

  .pc-checker__headline--fail .pc-checker__eyebrow::before {
    background: var(--pc-fail);
    box-shadow: 0 0 0.75rem var(--pc-fail);
  }

  .pc-checker__headline-text {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 4.2vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--pc-text);
  }

  .pc-checker__tiers,
  .pc-checker__advice-list {
    padding: 0;
    list-style: none;
  }

  .pc-checker__tiers {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pc-checker__tier {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--pc-line);
    border-radius: 0.875rem;
    background: rgb(0 0 0 / 0.2);
  }

  .pc-checker__tier-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .pc-checker__tier-label {
    font-weight: 600;
  }

  .pc-checker__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    flex: none;
    padding: 0.3125rem 0.6875rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .pc-checker__pill::before {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: currentColor;
  }

  .pc-checker__pill--pass {
    background: rgb(62 207 142 / 0.14);
    color: var(--pc-pass);
  }

  .pc-checker__pill--near {
    background: rgb(245 184 61 / 0.14);
    color: var(--pc-near);
  }

  .pc-checker__pill--fail {
    background: rgb(255 107 107 / 0.14);
    color: var(--pc-fail);
  }

  .pc-checker__scales {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .pc-checker__scale {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pc-checker__scale-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pc-muted);
  }

  .pc-checker__track {
    position: relative;
    height: 0.625rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
  }

  .pc-checker__fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--pc-accent), var(--pc-accent-2));
    box-shadow: 0 0 1rem rgb(255 140 90 / 0.5);
    transition: width 0.35s ease;
  }

  .pc-checker__tick {
    position: absolute;
    top: -0.3125rem;
    bottom: -0.3125rem;
    width: 2px;
    border-radius: 1px;
    background: var(--pc-text);
    opacity: 0.75;
    transform: translateX(-1px);
  }

  .pc-checker__advice {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid rgb(255 180 84 / 0.28);
    border-radius: 0.875rem;
    background: rgb(255 180 84 / 0.06);
  }

  .pc-checker__advice-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--pc-text);
  }

  .pc-checker__advice-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.9375rem;
  }

  .pc-checker__link {
    color: var(--pc-accent);
    text-decoration: underline;
    font-weight: 600;
    white-space: nowrap;
  }

  .pc-checker__reveal {
    animation: pc-checker-reveal 0.5s ease both;
  }

  @keyframes pc-checker-reveal {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-checker__fill,
    .pc-checker__button {
      transition: none;
    }

    .pc-checker__reveal {
      animation: none;
    }
  }

  .pc-checker__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--pc-line);
    border-radius: var(--pc-radius);
    background: var(--pc-surface);
  }

  .pc-checker__table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .pc-checker__table th,
  .pc-checker__table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--pc-line);
    text-align: start;
    vertical-align: top;
    color: var(--pc-text);
  }

  .pc-checker__table tbody tr:last-child :where(th, td) {
    border-bottom: 0;
  }

  .pc-checker__table thead th {
    color: var(--pc-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pc-checker__faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 46rem;
  }

  .pc-checker__faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pc-checker__faq-item {
    border: 1px solid var(--pc-line);
    border-radius: 0.875rem;
    background: var(--pc-surface);
  }

  .pc-checker__faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.125rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .pc-checker__faq-question::-webkit-details-marker {
    display: none;
  }

  .pc-checker__faq-question::after {
    content: '+';
    flex: none;
    color: var(--pc-accent);
    font-size: 1.25rem;
    line-height: 1;
  }

  .pc-checker__faq-item[open] .pc-checker__faq-question::after {
    content: '\2212';
  }

  .pc-checker__faq-question:focus-visible {
    outline: 2px solid var(--pc-accent);
    outline-offset: 2px;
    border-radius: 0.875rem;
  }

  .pc-checker__faq-answer {
    padding: 0 1.125rem 1.125rem;
    color: var(--pc-muted);
    font-size: 0.9375rem;
  }

  .pc-checker__title--page {
    font-size: clamp(2rem, 6.5vw, 3.5rem);
  }

  .pc-checker__article {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 40rem;
    color: var(--pc-text);
    font-size: 1.0625rem;
  }

  .pc-checker__article :where(h2) {
    margin-top: 0.5rem;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pc-text);
  }

  .pc-checker__article :where(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-inline-start: 1.25rem;
  }

  .pc-checker__article :where(a),
  .pc-checker__back a {
    color: var(--pc-accent);
    text-decoration: underline;
  }

  .pc-checker__back {
    font-size: 0.9375rem;
  }

  .pc-checker__cards {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .pc-checker__cards-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .pc-checker__cards-list a {
    display: inline-block;
    padding: 0.4375rem 0.75rem;
    border: 1px solid var(--pc-line);
    border-radius: 999px;
    background: var(--pc-surface);
    color: var(--pc-text);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .pc-checker__cards-list a:hover {
    border-color: var(--pc-accent);
    color: var(--pc-accent);
  }

  .pc-checker__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--pc-line);
    color: var(--pc-muted);
    font-size: 0.875rem;
  }

  .pc-checker__legal a,
  .pc-checker__gate-legal a {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PC checker",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "landing_mode",
      "label": "Landing page mode",
      "info": "Hides the store menu, cart and footer on the page that shows this section. Untick when the store is ready to open.",
      "default": true
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Can my PC run"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading, highlighted part",
      "default": "Grand Theft Auto VI?"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Unofficial estimate"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Pick your graphics card and processor to see our estimate for each quality level."
    },
    {
      "type": "textarea",
      "id": "notice",
      "label": "Notice shown under the introduction",
      "default": "No PC version has been announced and no official requirements exist. Everything on this page is our own estimate and will change when real requirements are published."
    },
    {
      "type": "textarea",
      "id": "method",
      "label": "How the estimate is made",
      "default": "The game launches on PlayStation 5 and Xbox Series X|S, including the less powerful Series S. We estimate the lowest level from that hardware and the higher levels from how earlier console games from the same studio ran on PC. Part scores are approximate averages, so two PCs with the same parts can still perform differently."
    },
    {
      "type": "text",
      "id": "updated",
      "label": "Last updated line",
      "default": "Estimates last reviewed November 2026."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Unofficial fan-made tool. Not affiliated with or endorsed by Rockstar Games or Take-Two Interactive. Grand Theft Auto is a trademark of its owner."
    },
    {
      "type": "checkbox",
      "id": "use_page_content",
      "label": "Use the page's own title and text",
      "info": "For pages about one graphics card. The heading and introduction above are then not used.",
      "default": false
    },
    {
      "type": "link_list",
      "id": "cards_menu",
      "label": "Menu listing the graphics card pages"
    },
    {
      "type": "text",
      "id": "cards_heading",
      "label": "Heading above the graphics card links",
      "default": "Check a specific graphics card"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Questions heading",
      "default": "Common questions"
    },
    {
      "type": "header",
      "content": "Email before result"
    },
    {
      "type": "checkbox",
      "id": "gate_result",
      "label": "Ask for an email before showing the result",
      "info": "When ticked, the result stays hidden until the visitor subscribes. The separate signup box below is not shown.",
      "default": true
    },
    {
      "type": "text",
      "id": "gate_heading",
      "label": "Heading on the locked result",
      "default": "Your result is ready"
    },
    {
      "type": "textarea",
      "id": "gate_text",
      "label": "Text on the locked result",
      "default": "Enter your email to see it. We will also email you when the PC version or its official requirements are announced. Unsubscribe any time."
    },
    {
      "type": "text",
      "id": "gate_button",
      "label": "Button on the locked result",
      "default": "Show my result"
    },
    {
      "type": "header",
      "content": "Email alerts"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup heading",
      "default": "Get an email when the PC version is announced"
    },
    {
      "type": "textarea",
      "id": "signup_text",
      "label": "Signup text",
      "default": "One email when a PC release date or official requirements are published. Unsubscribe any time."
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Signup button",
      "default": "Notify me"
    },
    {
      "type": "header",
      "content": "Upgrade links",
      "info": "Optional. A link only appears on the page when its box is filled in."
    },
    {
      "type": "url",
      "id": "gpu_link",
      "label": "Graphics cards link"
    },
    {
      "type": "url",
      "id": "cpu_link",
      "label": "Processors link"
    },
    {
      "type": "url",
      "id": "ram_link",
      "label": "Memory link"
    },
    {
      "type": "url",
      "id": "ssd_link",
      "label": "SSDs link"
    },
    {
      "type": "url",
      "id": "pc_link",
      "label": "Gaming PCs link"
    },
    {
      "type": "text",
      "id": "affiliate_note",
      "label": "Note shown with upgrade links",
      "default": "We may earn a commission if you buy through these links."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PC checker"
    }
  ]
}
{% endschema %}
